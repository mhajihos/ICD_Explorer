# ── WHO ICD-11 API ───────────────────────────────────────────────────────────
# Register at https://icd.who.int/icdapi to obtain these credentials.
WHO_CLIENT_ID=
WHO_CLIENT_SECRET=

# ── GitHub Personal Access Token ─────────────────────────────────────────────
# Required to fetch backupfile.xlsx from the private GitHub repo.
# Generate at https://github.com/settings/tokens (needs repo:read scope).
GITHUB_PAT=

# ── Optional: override the backupfile URL ────────────────────────────────────
CVC_XLSX_URL=https://raw.githubusercontent.com/mhajihos/CVC_ICD_Rep/main/backupfile.xlsx
